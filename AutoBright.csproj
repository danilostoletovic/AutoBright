<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\AutoBright.ico</ApplicationIcon>
    <Company>Danilo Stoletovic</Company>
    <Copyright>Copyright (c) 2026 Danilo Stoletovic</Copyright>
    <PackageProjectUrl>https://danilostoletovic.com</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/danilostoletovic/AutoBright</RepositoryUrl>
    <Authors>Danilo Stoletovic</Authors>
    <Description>Local camera-based adaptive laptop brightness</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\AutoBright.ico" />
  </ItemGroup>
</Project>
